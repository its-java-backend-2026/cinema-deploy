# Copiare in .env e cambiare i valori.
#   cp .env.example .env
#
# Il .env NON va nel repository: e' nel .gitignore. Nel repository ci va
# QUESTO file, che dice quali variabili servono senza rivelarne i valori.
# "env riempie i buchi, non sovrascrive niente": i buchi sono i ${...}
# scritti nel compose.

# --- database di shows-service ---
SHOWS_DB_NAME=shows_db
SHOWS_DB_USER=cinema
SHOWS_DB_PASSWORD=cinema

# --- database di booking-service (un database SUO, non uno schema) ---
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=cinema
BOOKING_DB_PASSWORD=cinema

# --- database di payment-service (G8) ---
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=cinema
PAYMENT_DB_PASSWORD=cinema

# --- database di loyalty-service (G8) ---
LOYALTY_DB_NAME=loyalty_db
LOYALTY_DB_USER=cinema
LOYALTY_DB_PASSWORD=cinema

# --- porte sull'HOST, se quelle di default sono gia' occupate ---
# Le porte INTERNE non cambiano mai: dentro la rete di compose i servizi si
# parlano su 8081-8085 e i database sulla 5432.
SHOWS_PORT=8081
PRICING_PORT=8082
BOOKING_PORT=8083
LOYALTY_PORT=8084
PAYMENT_PORT=8085
CATALOG_PROVIDER_PORT=8090

SHOWS_DB_PORT=5432
BOOKING_DB_PORT=5433
PAYMENT_DB_PORT=5434
LOYALTY_DB_PORT=5435

# --- verbosita' dei log ---
# SQL_LOG_LEVEL=DEBUG      per vedere le query (passo 3.2)
# FEIGN_LOG_LEVEL=DEBUG    per vedere le chiamate al fornitore (passo 6.8b)
SQL_LOG_LEVEL=INFO
FEIGN_LOG_LEVEL=INFO
BOOKING_LOG_LEVEL=INFO
PRICING_LOG_LEVEL=WARN
PAYMENT_LOG_LEVEL=INFO
LOYALTY_LOG_LEVEL=INFO

# --- la leva del passo 8.8 ---
# Sopra questo importo payment-service risponde 402 e la saga compensa.
# 20 posti da 10.00 euro fanno 200.00: con la soglia a 100.00 il fallimento
# si provoca senza toccare niente. Abbassarla a 5 lo provoca sempre.
CINEMA_PAYMENT_SOGLIA=100.00
